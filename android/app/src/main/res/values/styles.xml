<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- #308: let content draw into the display cutout area (notch/
             punch-hole) on API 28+ rather than letterboxing around it,
             matching this app's edge-to-edge layout (content padded via
             env(safe-area-inset-*) instead). No effect below API 28 (no
             cutout concept) or API 35+ (edge-to-edge/cutout drawing is
             already the enforced default there). -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- #653: @drawable/splash_screen_bg wraps the raw @capacitor/assets-
             generated @drawable/splash bitmap with android:gravity="center"
             instead of referencing it directly. A plain windowBackground
             bitmap defaults to Gravity.FILL, which stretches non-uniformly
             to the exact window bounds; since each density bucket's splash
             bitmap is generated for a fixed reference aspect ratio that
             rarely matches a real device's screen exactly, that stretch
             turned the circular turtle badge into a visible oval on-device.
             Centering at native size avoids the stretch. Survives re-running
             `npx capacitor-assets generate` since it only touches
             @drawable/splash, not this wrapper. -->
        <item name="android:background">@drawable/splash_screen_bg</item>
    </style>
</resources>